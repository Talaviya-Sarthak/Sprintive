# ─── Groq Whisper ─────────────────────────────────────────────────────────────
GROQ_API_KEY=

# Optional: constrain language (e.g. "en"). Empty = auto-detect.
GROQ_LANGUAGE=

# ─── Groq model ───────────────────────────────────────────────────────────────
GROQ_MODEL=whisper-large-v3

# ─── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ─── Backend callback (future async flows) ────────────────────────────────────
BACKEND_URL=http://localhost:5000
