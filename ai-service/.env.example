# ─── Service Communication Map ────────────────────────────────────────────────
# Link                          Communication                      Configured Local URL
# Frontend ➜ Backend            REST API                           http://localhost:5000/api
# Frontend ➜ Backend            WebSockets (Socket.IO)             http://localhost:5000
# Backend ➜ Frontend            CORS & OAuth redirects             http://localhost:5173
# Backend ➜ AI Service          Whisper STT & Transcript Handoff   http://localhost:8000
# Backend ➜ Transcript Service  14-Stage Preprocessing Pipeline    http://localhost:8001
# Backend ⟷ AI Service          Service-to-Service Security        sprintive_internal_service_secret_key_2026
# AI Service ➜ Backend          Async Webhook / Callback           http://localhost:5000
# ─────────────────────────────────────────────────────────────────────────────

# ─── Groq Whisper ─────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_LANGUAGE=
GROQ_MODEL=whisper-large-v3

# ─── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ─── Internal Service Authentication ──────────────────────────────────────────
INTERNAL_SERVICE_KEY=sprintive_internal_service_secret_key_2026

# ─── Backend Callback URL ────────────────────────────────────────────────────
BACKEND_URL=http://localhost:5000
