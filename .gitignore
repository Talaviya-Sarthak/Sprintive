# Root Git Ignore for Sprintive

# Environment variable files (NEVER commit secrets)
**/.env
**/.env.*
!**/.env.example

# Python cache & virtual environments
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/.venv/
**/venv/
**/.pytest_cache/

# Node dependencies & builds
**/node_modules/
**/dist/
**/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
