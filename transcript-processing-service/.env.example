# Server Configuration
PORT=8001
HOST=0.0.0.0
DEBUG=false
APP_ENV=development

# Storage Configuration
# Set to 'supabase' for production cloud storage or 'local' for local development
STORAGE_TYPE=supabase
STORAGE_BASE_DIR=./storage

# Supabase Storage Configuration (Required when STORAGE_TYPE=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=meetings

# Optional LLM-assisted correction settings (fallback to rule-based when empty)
LLM_PROVIDER=openai
LLM_API_KEY=your_openai_api_key
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=10.0
