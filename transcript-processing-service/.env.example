# ─── Service Communication Map ────────────────────────────────────────────────
# Link                          Communication                      Configured Local URL
# Frontend ➜ Backend            REST API                           http://localhost:5000/api
# Frontend ➜ Backend            WebSockets (Socket.IO)             http://localhost:5000
# Backend ➜ Frontend            CORS & OAuth redirects             http://localhost:5173
# Backend ➜ AI Service          Whisper STT & Transcript Handoff   http://localhost:8000
# Backend ➜ Transcript Service  14-Stage Preprocessing Pipeline    http://localhost:8001
# Backend ⟷ AI Service          Service-to-Service Security        sprintive_internal_service_secret_key_2026
# AI Service ➜ Backend          Async Webhook / Callback           http://localhost:5000
# ─────────────────────────────────────────────────────────────────────────────

# ─── Server Configuration ─────────────────────────────────────────────────────
PORT=8001
HOST=0.0.0.0
DEBUG=false
APP_ENV=development

# ─── Storage Configuration ────────────────────────────────────────────────────
STORAGE_TYPE=supabase
STORAGE_BASE_DIR=./storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=sprintive-storage

# ─── LLM Configuration ────────────────────────────────────────────────────────
GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
LLM_MAX_TOKENS=1024

# ─── Groq Reliability, Fallback & Rate Limiting ──────────────────────────────
GROQ_PRIMARY_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,allam-2-7b,openai/gpt-oss-20b
GROQ_MAX_RETRIES=2
GROQ_REQUEST_TIMEOUT=10.0
GROQ_MAX_BACKOFF_SECONDS=15.0
GROQ_CIRCUIT_BREAKER_COOLDOWN_SECONDS=300.0
GROQ_CONCURRENCY_LIMIT=1
GROQ_PACING_DELAY_SECONDS=0.5
