# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── GitHub OAuth ─────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=

# ─── Object Storage ───────────────────────────────────────────────────────────
# One string to switch Supabase projects instantly.
# Format: {project-ref}:{service-role-key}
#
# Find these in Supabase Dashboard:
#   1. Project Ref: Settings → General → Project URL (the part before .supabase.co)
#   2. Service Role Key: Settings → API → service_role (starts with eyJ...)
#
# Example:
#   SUPABASE_STORAGE_URL=zekayjgbsjluziukrzof:eyJhbGciOiJIUzI1NiIs...
#   SUPABASE_BUCKET=sprintive-storage
#
STORAGE_PROVIDER=supabase
SUPABASE_STORAGE_URL=
SUPABASE_BUCKET=meetings

# ─── Transcript Processing Service ──────────────────────────────────────────
TRANSCRIPT_PROCESSING_SERVICE_URL=http://localhost:8001

# ─── AI Service (Meeting Understanding & STT) ──────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
INTERNAL_SERVICE_KEY=your_internal_service_key_here
AI_SERVICE_TIMEOUT_MS=10000

# ─── Deepgram STT (Live streaming speech-to-text) ──────────────────────────
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_MODEL=nova-3

# ─── Brevo Transactional Email API ─────────────────────────────────────────────
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=noreply@sprintive.app
BREVO_SENDER_NAME=Sprintive

