# ─── Service Communication Map ────────────────────────────────────────────────
# Link                          Communication                      Configured Local URL
# Frontend ➜ Backend            REST API                           http://localhost:5000/api
# Frontend ➜ Backend            WebSockets (Socket.IO)             http://localhost:5000
# Backend ➜ Frontend            CORS & OAuth redirects             http://localhost:5173
# Backend ➜ AI Service          Whisper STT & Transcript Handoff   http://localhost:8000
# Backend ➜ Transcript Service  14-Stage Preprocessing Pipeline    http://localhost:8001
# Backend ⟷ AI Service          Service-to-Service Security        sprintive_internal_service_secret_key_2026
# AI Service ➜ Backend          Async Webhook / Callback           http://localhost:5000
# ─────────────────────────────────────────────────────────────────────────────

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Frontend & Microservices Communication ──────────────────────────────────
FRONTEND_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000
TRANSCRIPT_PROCESSING_SERVICE_URL=http://localhost:8001
INTERNAL_SERVICE_KEY=sprintive_internal_service_secret_key_2026
AI_SERVICE_TIMEOUT_MS=60000

# ─── Redis / BullMQ Queue ─────────────────────────────────────────────────────
# Upstash Redis TLS connection string (format: rediss://default:<password>@<host>:6379)
REDIS_URL=

# ─── Email ────────────────────────────────────────────────────────────────────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Sprintive

# ─── Object Storage ───────────────────────────────────────────────────────────
STORAGE_PROVIDER=supabase
SUPABASE_STORAGE_URL=
SUPABASE_BUCKET=sprintive-storage

# ─── Deepgram STT ────────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
